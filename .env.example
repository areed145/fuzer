# Copy to .env and fill in. Variables already set in your shell win over this file.
# Everything else lives elsewhere: a project's pack, data folder, timezone and timeseries source in its project
# (`fuzer projects list`); models, thresholds and the PI and ADX addresses are settings (the Settings page, or
# `fuzer settings set <key> <value>`; docs/settings.md lists them). The old variables still work for one release.

# Provider keys (choose the provider in Settings; API key settings refer to these environment variables)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Database: unset starts a built-in Postgres in FUZER_PGDATA
FUZER_DATABASE_URL=postgresql://fuzer:fuzer@localhost:5432/fuzer

# The project to open when none is given (--project wins)
# FUZER_PROJECT=

# Secrets. The secret settings hold a reference to one of these, never the value; these names are the defaults.
# FUZER_PI_PASSWORD=
# FUZER_ADX_TOKEN=
# FUZER_ALERT_WEBHOOK=

# Deployment trust/bootstrap configuration (not ordinary operational settings).
# Default sign-in accepts personal Microsoft and work/school accounts; see docs/deployment.md.
# FUZER_AUTH_MODE=microsoft
# FUZER_PUBLIC_URL=https://your-existing-service.example
# FUZER_MICROSOFT_CLIENT_ID=
# FUZER_MICROSOFT_CLIENT_SECRET=
# FUZER_OWNER_BOOTSTRAP_TOKEN=   # random hosting secret, at least 32 characters; remove after owner setup
# Trusted development only: explicitly set FUZER_AUTH_MODE=local and bind to loopback.
