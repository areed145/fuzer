# Copy to .env and fill in. Variables already set in your shell win over this file.
# Only ANTHROPIC_API_KEY is a secret; everything else is optional and shows its default.

# Claude readers (fuzer llm-link, the nightly claude_reading job)
ANTHROPIC_API_KEY=
# FUZER_LLM_MODEL=claude-opus-5-5
# FUZER_LLM_EFFORT=medium

# Database: unset starts a built-in Postgres in FUZER_PGDATA
# FUZER_DATABASE_URL=postgresql://fuzer:fuzer@localhost:5432/fuzer
# FUZER_PGDATA=.fuzer/pgdata
# FUZER_WORK_MEM=256MB

# Asset and exports. The fake assets live in fakeplant/data/<asset> (uv run fakeplant demo).
# FUZER_PACK=offshore_demo
# FUZER_DATA_DIR=fakeplant/data/offshore

# PI Web API: the point list and AF tree load from it instead of files (#15).
# A fake one over the fake plant: uv run fakeplant historian --asset okan  (port 8100)
# FUZER_PI_WEB_API_URL=http://127.0.0.1:8100/piwebapi
# FUZER_PI_DATA_SERVER=          # default: the first data server
# FUZER_PI_AF_SERVER=            # default: the first AF server
# FUZER_PI_AF_DATABASE=          # default: its first database
# FUZER_PI_USER= / FUZER_PI_PASSWORD=  (basic auth)
# FUZER_PI_VERIFY_TLS=1

# ADX: the series catalog puts a pointer on each PI point's timeseries entity (#16).
# FUZER_ADX_URL=http://127.0.0.1:8100
# FUZER_ADX_DATABASE=OKAN
# FUZER_ADX_TOKEN=               # bearer token (Entra sign-in comes with #12)
# FUZER_ADX_CATALOG=SeriesCatalog

# Operations assistant (uv sync --extra agents; fuzer ask / chat, the Ask page). Uses ANTHROPIC_API_KEY.
# FUZER_AGENT_MODEL=claude-opus-5-5
# FUZER_AGENT_EFFORT=high                # orchestrator
# FUZER_AGENT_SPECIALIST_EFFORT=medium
# FUZER_AGENT_FALLBACKS=1                # 0 turns off Claude's server-side refusal fallback

# Process values around events: synthetic (needs nothing), pi or adx
# FUZER_TIMESERIES=synthetic

# Dagster jobs
# FUZER_TIMEZONE=UTC
# FUZER_ALERT_WEBHOOK=
# DAGSTER_HOME=.dagster
