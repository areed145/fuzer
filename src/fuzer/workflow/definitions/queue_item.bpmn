<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fuzer="https://fuzer.dev/schema/bpmn" id="Definitions_queue_item" targetNamespace="https://fuzer.dev/workflow">
  <bpmn:collaboration id="Collaboration_queue_item">
    <bpmn:documentation>The standard process for work whose type names a queue and no process of its own (#509): one step in that role's queue, with the role's SLA and escalation. The type's role and case type come in the start data. Sending the case to the field is a step of its own (#1145): the field operator's Field check, whose report comes back to whoever sent them.</bpmn:documentation>
    <bpmn:participant id="Participant_queue_item" name="Queue item" processRef="queue_item" />
  </bpmn:collaboration>
  <bpmn:process id="queue_item" name="Queue item" isExecutable="true" fuzer:workItemType="=case_type" fuzer:correlationKey="exception_id" fuzer:ownerRole="ops_lead" fuzer:closeWithCase="true">
    <bpmn:laneSet id="LaneSet_queue_item">
      <bpmn:lane id="Lane_queue" name="The type's queue" fuzer:role="=role">
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>to_field</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_field" name="Field operator" fuzer:role="operator">
        <bpmn:flowNodeRef>field_check</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="arrived" name="Work arrived">
      <bpmn:outgoing>f_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="work" name="Work the case" fuzer:dispatch="field_route=field_check" fuzer:gate="field_dispatch">
      <bpmn:incoming>f_start</bpmn:incoming>
      <bpmn:incoming>f_checked</bpmn:incoming>
      <bpmn:outgoing>f_worked</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="to_field" name="Send to the field?" default="f_done">
      <bpmn:incoming>f_worked</bpmn:incoming>
      <bpmn:outgoing>f_field</bpmn:outgoing>
      <bpmn:outgoing>f_done</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="field_check" name="Field check" fuzer:sla="PT8H">
      <bpmn:incoming>f_field</bpmn:incoming>
      <bpmn:outgoing>f_checked</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="finished" name="Done">
      <bpmn:incoming>f_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start" sourceRef="arrived" targetRef="work" />
    <bpmn:sequenceFlow id="f_worked" sourceRef="work" targetRef="to_field" />
    <bpmn:sequenceFlow id="f_field" name="Send someone to look" sourceRef="to_field" targetRef="field_check">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">field_route == "field_check"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_done" name="Done" sourceRef="to_field" targetRef="finished" />
    <bpmn:sequenceFlow id="f_checked" name="Field report" sourceRef="field_check" targetRef="work" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_queue_item">
    <bpmndi:BPMNPlane id="Plane_queue_item" bpmnElement="Collaboration_queue_item">
      <bpmndi:BPMNShape id="Participant_queue_item_di" bpmnElement="Participant_queue_item" isHorizontal="true"><dc:Bounds x="0" y="60" width="620" height="320" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_queue_di" bpmnElement="Lane_queue" isHorizontal="true"><dc:Bounds x="30" y="60" width="590" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_field_di" bpmnElement="Lane_field" isHorizontal="true"><dc:Bounds x="30" y="220" width="590" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="arrived_di" bpmnElement="arrived"><dc:Bounds x="102" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="work_di" bpmnElement="work"><dc:Bounds x="190" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="to_field_di" bpmnElement="to_field" isMarkerVisible="true"><dc:Bounds x="355" y="115" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="field_check_di" bpmnElement="field_check"><dc:Bounds x="330" y="260" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finished_di" bpmnElement="finished"><dc:Bounds x="502" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_di" bpmnElement="f_start"><di:waypoint x="138" y="140" /><di:waypoint x="190" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_worked_di" bpmnElement="f_worked"><di:waypoint x="290" y="140" /><di:waypoint x="355" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_done_di" bpmnElement="f_done"><di:waypoint x="405" y="140" /><di:waypoint x="502" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_field_di" bpmnElement="f_field"><di:waypoint x="380" y="165" /><di:waypoint x="380" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_checked_di" bpmnElement="f_checked"><di:waypoint x="330" y="300" /><di:waypoint x="240" y="300" /><di:waypoint x="240" y="180" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
