<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fuzer="https://fuzer.dev/schema/bpmn" id="Definitions_queue_item" targetNamespace="https://fuzer.dev/workflow">
  <bpmn:collaboration id="Collaboration_queue_item">
    <bpmn:documentation>The standard process for work whose type names a queue and no process of its own (#509): one step in that role's queue, with the role's SLA and escalation. The type's role and case type come in the start data.</bpmn:documentation>
    <bpmn:participant id="Participant_queue_item" name="Queue item" processRef="queue_item" />
  </bpmn:collaboration>
  <bpmn:process id="queue_item" name="Queue item" isExecutable="true" fuzer:workItemType="=case_type" fuzer:correlationKey="exception_id" fuzer:ownerRole="ops_lead">
    <bpmn:laneSet id="LaneSet_queue_item">
      <bpmn:lane id="Lane_queue" name="The type's queue" fuzer:role="=role">
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="arrived" name="Work arrived">
      <bpmn:outgoing>f_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="work" name="Work the case">
      <bpmn:incoming>f_start</bpmn:incoming>
      <bpmn:outgoing>f_done</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="finished" name="Done">
      <bpmn:incoming>f_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start" sourceRef="arrived" targetRef="work" />
    <bpmn:sequenceFlow id="f_done" sourceRef="work" targetRef="finished" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_queue_item">
    <bpmndi:BPMNPlane id="Plane_queue_item" bpmnElement="Collaboration_queue_item">
      <bpmndi:BPMNShape id="Participant_queue_item_di" bpmnElement="Participant_queue_item" isHorizontal="true"><dc:Bounds x="0" y="60" width="520" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_queue_di" bpmnElement="Lane_queue" isHorizontal="true"><dc:Bounds x="30" y="60" width="490" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="arrived_di" bpmnElement="arrived"><dc:Bounds x="102" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="work_di" bpmnElement="work"><dc:Bounds x="210" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finished_di" bpmnElement="finished"><dc:Bounds x="392" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_di" bpmnElement="f_start"><di:waypoint x="138" y="140" /><di:waypoint x="210" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_done_di" bpmnElement="f_done"><di:waypoint x="310" y="140" /><di:waypoint x="392" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
