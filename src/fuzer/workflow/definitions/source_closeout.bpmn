<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fuzer="https://fuzer.dev/schema/bpmn" id="Definitions_source_closeout" targetNamespace="https://fuzer.dev/workflow">
  <bpmn:collaboration id="Collaboration_source_closeout">
    <bpmn:documentation>A close-out back to the source system (#466, #509): the field finished work another system raised; the system's close-out role approves (or edits, or discards) the drafted update, which finishes this step.</bpmn:documentation>
    <bpmn:participant id="Participant_source_closeout" name="Source close-out" processRef="source_closeout" />
  </bpmn:collaboration>
  <bpmn:process id="source_closeout" name="Source close-out" isExecutable="true" fuzer:workItemType="source_closeout" fuzer:correlationKey="closeout_id" fuzer:ownerRole="ops_lead">
    <bpmn:laneSet id="LaneSet_source_closeout">
      <bpmn:lane id="Lane_queue" name="The system's close-out role" fuzer:role="=role">
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="arrived" name="Field finished">
      <bpmn:outgoing>f_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="work" name="Approve the update to the source system">
      <bpmn:incoming>f_start</bpmn:incoming>
      <bpmn:outgoing>f_done</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="finished" name="Decided">
      <bpmn:incoming>f_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start" sourceRef="arrived" targetRef="work" />
    <bpmn:sequenceFlow id="f_done" sourceRef="work" targetRef="finished" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_source_closeout">
    <bpmndi:BPMNPlane id="Plane_source_closeout" bpmnElement="Collaboration_source_closeout">
      <bpmndi:BPMNShape id="Participant_source_closeout_di" bpmnElement="Participant_source_closeout" isHorizontal="true"><dc:Bounds x="0" y="60" width="520" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_queue_di" bpmnElement="Lane_queue" isHorizontal="true"><dc:Bounds x="30" y="60" width="490" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="arrived_di" bpmnElement="arrived"><dc:Bounds x="102" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="work_di" bpmnElement="work"><dc:Bounds x="210" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finished_di" bpmnElement="finished"><dc:Bounds x="392" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_di" bpmnElement="f_start"><di:waypoint x="138" y="140" /><di:waypoint x="210" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_done_di" bpmnElement="f_done"><di:waypoint x="310" y="140" /><di:waypoint x="392" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
