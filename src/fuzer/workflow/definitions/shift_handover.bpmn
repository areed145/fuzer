<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:fuzer="https://fuzer.dev/schema/bpmn" id="Definitions_shift_handover" targetNamespace="https://fuzer.dev/workflow">
  <bpmn:collaboration id="Collaboration_shift_handover">
    <bpmn:documentation>The shift handover (#467, #509): drafted at each shift change from live work; the outgoing lead adds notes and the incoming lead acknowledges it on the Handover page, which finishes this step.</bpmn:documentation>
    <bpmn:participant id="Participant_shift_handover" name="Shift handover" processRef="shift_handover" />
  </bpmn:collaboration>
  <bpmn:process id="shift_handover" name="Shift handover" isExecutable="true" fuzer:workItemType="shift_handover" fuzer:correlationKey="handover_id" fuzer:ownerRole="ops_lead">
    <bpmn:laneSet id="LaneSet_shift_handover">
      <bpmn:lane id="Lane_queue" name="Ops lead" fuzer:role="ops_lead">
        <bpmn:flowNodeRef>arrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finished</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="arrived" name="Shift changed">
      <bpmn:outgoing>f_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="work" name="Read and acknowledge the handover">
      <bpmn:incoming>f_start</bpmn:incoming>
      <bpmn:outgoing>f_done</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="finished" name="Acknowledged">
      <bpmn:incoming>f_done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start" sourceRef="arrived" targetRef="work" />
    <bpmn:sequenceFlow id="f_done" sourceRef="work" targetRef="finished" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_shift_handover">
    <bpmndi:BPMNPlane id="Plane_shift_handover" bpmnElement="Collaboration_shift_handover">
      <bpmndi:BPMNShape id="Participant_shift_handover_di" bpmnElement="Participant_shift_handover" isHorizontal="true"><dc:Bounds x="0" y="60" width="520" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_queue_di" bpmnElement="Lane_queue" isHorizontal="true"><dc:Bounds x="30" y="60" width="490" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="arrived_di" bpmnElement="arrived"><dc:Bounds x="102" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="work_di" bpmnElement="work"><dc:Bounds x="210" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finished_di" bpmnElement="finished"><dc:Bounds x="392" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_di" bpmnElement="f_start"><di:waypoint x="138" y="140" /><di:waypoint x="210" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_done_di" bpmnElement="f_done"><di:waypoint x="310" y="140" /><di:waypoint x="392" y="140" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
