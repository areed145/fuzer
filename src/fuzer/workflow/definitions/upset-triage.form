{
  "id": "upset-triage",
  "type": "default",
  "schemaVersion": 19,
  "fuzer": {
    "bulk": [{"label": "Close as false alarm", "data": {"triage": "false_alarm"}, "reason_key": "triage_note"}]
  },
  "components": [
    {"type": "text", "id": "intro", "text": "Look at the evidence and decide whether this is a real upset. A real upset goes to the field operations agent for a diagnosis. If you can't tell from here, send a field operator to look: their report comes back to you on this step."},
    {"type": "radio", "id": "triage", "key": "triage", "label": "Is it a real upset?",
     "values": [{"label": "Real upset: diagnose it", "value": "real"}, {"label": "Not sure: send someone to look", "value": "field_check"}, {"label": "False alarm: close it", "value": "false_alarm"}],
     "validate": {"required": true}},
    {"type": "textarea", "id": "field_ask", "key": "field_ask", "label": "What should they check?",
     "description": "The operator sees this first on their job.", "validate": {"required": true},
     "conditional": {"hide": "=triage != \"field_check\""}},
    {"type": "textarea", "id": "triage_note", "key": "triage_note", "label": "Note",
     "description": "What you saw, for the diagnosis or for the record."}
  ]
}
