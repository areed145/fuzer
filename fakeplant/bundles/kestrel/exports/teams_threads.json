         "from": {"user": {"id": "u-05", "displayName": "Tomas Herrera"}},
         "body": {"contentType": "html", "content": "<p>Fuel gas pressure at the burner?</p>"}},
        {"id": "1731000000103", "messageType": "message", "replyToId": "1731000000101", "createdDateTime": "today-7d 15:30",
         "from": {"user": {"id": "u-04", "displayName": "Ken Mbeki"}},
